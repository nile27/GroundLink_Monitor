<Window x:Class="GroundLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="관제 테스트" Height="950" Width="1000"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="TestButton"
                    Content="최신 값 조회"
                    Width="150"
                    Margin="0,0,8,0"
                    Click="TestButton_Click"/>
            <Button x:Name="ConnectButton"
                    Content="시뮬레이터 연결"
                    Width="150"
                    Click="ConnectButton_Click"/>
        </StackPanel>

        <!-- 연결 상태 -->
        <TextBlock x:Name="LiveText"
                   Margin="0,15,0,0"
                   Text="실시간: 연결 안 됨"/>

        <!-- 현재 값 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="BatteryText"
                       FontSize="20"
                       Width="460"
                       Text="배터리: -"/>
            <TextBlock x:Name="TemperatureText"
                       FontSize="20"
                       Text="배터리 온도: -"/>
        </StackPanel>

        <!-- 실시간 차트: 배터리 | 배터리 온도 -->
        <Grid Margin="0,10,0,0" Height="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScottPlot:WpfPlot x:Name="BatteryLivePlot" Grid.Column="0"/>
            <ScottPlot:WpfPlot x:Name="TemperatureLivePlot" Grid.Column="1"/>
        </Grid>

        <!-- 오류 메시지 -->
        <TextBlock x:Name="ResultText"
                   Margin="0,10,0,0"
                   Foreground="Red"
                   TextWrapping="Wrap"/>

        <!-- 기간 버튼 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="1시간" Width="80" Margin="0,0,8,0" Click="HourButton_Click"/>
            <Button Content="1일"   Width="80" Margin="0,0,8,0" Click="DayButton_Click"/>
            <Button Content="1주일" Width="80" Click="WeekButton_Click"/>
        </StackPanel>

        <!-- 과거 기록: 위 = 결론 한 줄, 아래 = 근거 차트 / 왼쪽 = 배터리, 오른쪽 = 배터리 온도 -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="330"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="BatteryHistorySummaryText"
                       Grid.Row="0" Grid.Column="0"
                       FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="배터리: -"/>
            <TextBlock x:Name="TemperatureHistorySummaryText"
                       Grid.Row="0" Grid.Column="1"
                       FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="배터리 온도: -"/>

            <ScottPlot:WpfPlot x:Name="BatteryHistoryPlot" Grid.Row="1" Grid.Column="0"/>
            <ScottPlot:WpfPlot x:Name="TemperatureHistoryPlot" Grid.Row="1" Grid.Column="1"/>
        </Grid>
    </StackPanel>
</Window>