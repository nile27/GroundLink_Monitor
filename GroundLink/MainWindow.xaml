<Window x:Class="GroundLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GroundLink.Converters"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="GroundLink Monitor" Height="760" Width="1240">

    <!-- 이 창에서 이름(x:Key)으로 꺼내 쓸 변환기 -->
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="ContactBrush" TrueBrush="#43A047" FalseBrush="#BDBDBD" />
        <conv:BoolToTextConverter x:Key="ContactText" TrueText="교신 중" FalseText="교신 없음" />
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- ═════════ 위: 위성 상태 요약 바 (1초마다 갱신) ═════════ -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,12">
            <!-- 네 칸 공통 모양 -->
            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderBrush" Value="#DDD" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </UniformGrid.Resources>

            <Border>
                <StackPanel>
                    <TextBlock Text="전체 위성" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="경고" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold" Foreground="#E53935" />
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="SAFE 모드" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="{Binding SafeCount}" FontSize="24" FontWeight="Bold" Foreground="#FB8C00" />
                </StackPanel>
            </Border>

            <!-- 마지막 칸은 오른쪽 여백 없음 -->
            <Border Margin="0">
                <StackPanel>
                    <TextBlock Text="교신 중" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="{Binding ContactCount}" FontSize="24" FontWeight="Bold" Foreground="#43A047" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═════════ 아래: 기존 화면 (남은 공간을 채움) ═════════ -->
        <Grid>
            <!-- 왼쪽: 목록 + 알람 / 오른쪽: 상세 패널 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ═════════ 왼쪽 ═════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- 위성 카드 목록 -->
                    <RowDefinition Height="200" />  <!-- 알람 표 -->
                </Grid.RowDefinitions>

                <!-- 위성 카드 목록
                     가상화: 화면에 보이는 카드만 만들고 재활용
                     (측정: 가상화 없이 10000대는 응답 없음 → 가상화 후 0.4초) -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Satellites}"
                         SelectedItem="{Binding SelectedSatellite}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         BorderThickness="0">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- 위성 하나(SatelliteStatus)를 그리는 카드 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="8" Padding="12"
                                    CornerRadius="8" BorderThickness="2">
                                <!-- 경고 상태면 빨간 카드 (기본값도 Style 안에 둬야 트리거가 먹힘) -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#DDD" />
                                        <Setter Property="Background" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="BorderBrush" Value="#E53935" />
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{Binding Battery, StringFormat='배터리: {0:F1}%'}" />
                                    <TextBlock Text="{Binding Temperature, StringFormat='온도: {0:F1}°C'}" />
                                    <TextBlock Text="{Binding Mode, StringFormat='모드: {0}'}" />

                                    <!-- 교신 상태: 점 색 + 글자 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding InContact, Converter={StaticResource ContactBrush}}" />
                                        <TextBlock Text="{Binding InContact, Converter={StaticResource ContactText}}" />
                                    </StackPanel>

                                    <!-- 카드 안에서 {Binding}은 위성 하나라서,
                                         ViewModel의 명령은 위쪽 목록의 DataContext로 찾아간다 -->
                                    <Button Margin="0,8,0,0" Content="모드 전환"
                                            Command="{Binding DataContext.ToggleSafeModeCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 알람 표 -->
                <GroupBox Grid.Row="1" Header="알람" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding Alarms}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Width="80"
                                                Binding="{Binding Time, StringFormat='HH:mm:ss'}" />
                            <DataGridTextColumn Header="위성" Width="90"
                                                Binding="{Binding SatelliteId}" />
                            <DataGridTextColumn Header="내용" Width="*"
                                                Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- ═════════ 오른쪽: 선택된 위성 상세 ═════════ -->
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16"
                    CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <!-- FallbackValue: 선택이 없어서 값을 못 찾을 때 보여줄 글자 -->
                    <TextBlock FontSize="20" FontWeight="Bold"
                               Text="{Binding SelectedSatellite.Id, FallbackValue='위성을 선택하세요'}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding SelectedSatellite.Battery, StringFormat='배터리: {0:F1}%', FallbackValue=''}" />
                    <TextBlock Text="{Binding SelectedSatellite.Temperature, StringFormat='온도: {0:F1}°C', FallbackValue=''}" />
                    <TextBlock Text="{Binding SelectedSatellite.Mode, StringFormat='모드: {0}', FallbackValue=''}" />
                    <TextBlock Text="{Binding SelectedSatellite.InContact, Converter={StaticResource ContactText}, FallbackValue=''}" />

                    <!-- 차트 기간 선택 -->
                    <ComboBox Width="140" Margin="0,16,0,0" HorizontalAlignment="Left"
                              ItemsSource="{Binding Periods}"
                              SelectedItem="{Binding SelectedPeriod}"
                              DisplayMemberPath="Label" />

                    <!-- 배터리 차트 (DB에서 요약 조회) -->
                    <oxy:PlotView Model="{Binding BatteryPlot}" Height="260" Margin="0,8,0,0" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="{Binding ChartInfo}" />

                    <!-- 선택이 없으면 CanExecute가 false라 자동 비활성화 -->
                    <Button Margin="0,16,0,0" Content="모드 전환"
                            Command="{Binding ToggleSafeModeCommand}"
                            CommandParameter="{Binding SelectedSatellite}" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
