<Window x:Class="GroundLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GroundLink.Converters"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="GroundLink Monitor" Height="760" Width="1240">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="ContactBrush" TrueBrush="#43A047" FalseBrush="#BDBDBD" />
        <conv:BoolToTextConverter x:Key="ContactText" TrueText="교신 중" FalseText="교신 없음" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 위(카드 목록) / 아래(알람 표) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <!-- 카드 목록 -->
            <ListBox Grid.Row="0"
                     ItemsSource="{Binding Satellites}"
                     SelectedItem="{Binding SelectedSatellite}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Margin="8" Padding="12"
                                CornerRadius="8" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#DDD" />
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E53935" />
                                            <Setter Property="Background" Value="#FFEBEE" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding Battery, StringFormat='배터리: {0:F1}%'}" />
                                <TextBlock Text="{Binding Temperature, StringFormat='온도: {0:F1}°C'}" />
                                <TextBlock Text="{Binding Mode, StringFormat='모드: {0}'}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding InContact, Converter={StaticResource ContactBrush}}" />
                                    <TextBlock Text="{Binding InContact, Converter={StaticResource ContactText}}" />
                                </StackPanel>
                                <Button Margin="0,8,0,0" Content="모드 전환"
                                        Command="{Binding DataContext.ToggleSafeModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 알람 표 -->
            <GroupBox Grid.Row="1" Header="알람" Margin="0,8,0,0">
                <DataGrid ItemsSource="{Binding Alarms}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시각" Width="80"
                                            Binding="{Binding Time, StringFormat='HH:mm:ss'}" />
                        <DataGridTextColumn Header="위성" Width="80"
                                            Binding="{Binding SatelliteId}" />
                        <DataGridTextColumn Header="내용" Width="*"
                                            Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- 오른쪽: 상세 패널 -->
        <Border Grid.Column="1" Margin="16,0,0,0" Padding="16"
                CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold"
                           Text="{Binding SelectedSatellite.Id, FallbackValue='위성을 선택하세요'}" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding SelectedSatellite.Battery, StringFormat='배터리: {0:F1}%', FallbackValue=''}" />
                <TextBlock Text="{Binding SelectedSatellite.Temperature, StringFormat='온도: {0:F1}°C', FallbackValue=''}" />
                <TextBlock Text="{Binding SelectedSatellite.Mode, StringFormat='모드: {0}', FallbackValue=''}" />
                <TextBlock Text="{Binding SelectedSatellite.InContact, Converter={StaticResource ContactText}, FallbackValue=''}" />

                <oxy:PlotView Model="{Binding BatteryPlot}" Height="220" Margin="0,16,0,0" />

                <Button Margin="0,16,0,0" Content="모드 전환"
                        Command="{Binding ToggleSafeModeCommand}"
                        CommandParameter="{Binding SelectedSatellite}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>