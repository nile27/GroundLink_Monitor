<Window x:Class="GroundLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="GroundLink 관제" Height="1000" Width="1200"
        Background="#0B1220" Foreground="#E6EDF7"
        FontFamily="Malgun Gothic"
        Loaded="Window_Loaded">

    <!-- 색은 Theme.cs와 같은 값 -->
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#111A2B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1F2A3D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <!-- 카드: 내용 묶음마다 같은 바탕·테두리 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 버튼: 기본 WPF 버튼은 어두운 바탕에서 회색 상자로 보여서 모양을 새로 정함 -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6EDF7"/>
            <Setter Property="Background" Value="#1A2438"/>
            <Setter Property="BorderBrush" Value="#2A3650"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 주 버튼 (시뮬레이터 연결): 눈에 띄게 강조색 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- 1. 상단 바: 이름 · 위성 · 연결 상태 | 버튼 -->
            <Border Style="{StaticResource Card}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TestButton"
                                Content="최신 값 조회"
                                Style="{StaticResource DarkButton}"
                                Margin="0,0,8,0"
                                Click="TestButton_Click"/>
                        <Button x:Name="ConnectButton"
                                Content="시뮬레이터 연결"
                                Style="{StaticResource PrimaryButton}"
                                Click="ConnectButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GroundLink" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1A2438" CornerRadius="4" Padding="8,2" Margin="10,0,24,0">
                            <TextBlock Text="SAT-001" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <Ellipse x:Name="StatusDot"
                                 Width="10" Height="10"
                                 Fill="#94A3B8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="연결 안 됨"/>
                        <TextBlock x:Name="LiveText"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. 현재 값: 배터리 | 배터리 온도 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="배터리 잔량" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="BatteryText" Text="-" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="BatteryMarginText" Text="경고 기준 60 % 미만" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="배터리 온도" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TemperatureText" Text="-" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TemperatureMarginText" Text="경고 기준 0 °C 미만 · 40 °C 초과" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 실시간 차트: 배터리 | 배터리 온도 -->
            <Grid Margin="0,12,0,0" Height="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                    <ScottPlot:WpfPlot x:Name="BatteryLivePlot"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                    <ScottPlot:WpfPlot x:Name="TemperatureLivePlot"/>
                </Border>
            </Grid>

            <!-- 오류 메시지 -->
            <TextBlock x:Name="ResultText"
                       Margin="0,8,0,0"
                       Foreground="#F87171"
                       TextWrapping="Wrap"/>

            <!-- 4. 과거 기록: 제목·설명 | 기간 버튼 / 결론 한 줄 / 근거 차트 -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="RecentButton" Content="최근 3시간" Style="{StaticResource DarkButton}"
                                    Margin="0,0,6,0" Click="RecentButton_Click"/>
                            <Button x:Name="DayButton" Content="1일" Style="{StaticResource DarkButton}"
                                    Margin="0,0,6,0" Click="DayButton_Click"/>
                            <Button x:Name="WeekButton" Content="1주일" Style="{StaticResource DarkButton}"
                                    Click="WeekButton_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="과거 기록" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistoryDescriptionText"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="320"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="BatteryHistorySummaryText"
                                   Grid.Row="0" Grid.Column="0"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="배터리: -"/>
                        <TextBlock x:Name="TemperatureHistorySummaryText"
                                   Grid.Row="0" Grid.Column="2"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="배터리 온도: -"/>

                        <ScottPlot:WpfPlot x:Name="BatteryHistoryPlot" Grid.Row="1" Grid.Column="0"/>
                        <ScottPlot:WpfPlot x:Name="TemperatureHistoryPlot" Grid.Row="1" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
